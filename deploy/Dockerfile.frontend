# Stage 1: Build React SPA
FROM node:20-alpine AS builder

WORKDIR /app

# 先复制 package 文件安装依赖（利用 Docker 缓存层）
COPY frontend/package.json frontend/package-lock.json* ./frontend/
COPY frontend/client/package.json ./frontend/client/

WORKDIR /app/frontend
RUN npm ci --legacy-peer-deps 2>/dev/null || npm install --legacy-peer-deps

# 复制源码构建
COPY frontend/ /app/frontend/

# 构建时注入环境变量
ARG VITE_SENTRY_DSN=""
ARG VITE_SENTRY_ENVIRONMENT="production"
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT

WORKDIR /app/frontend/client
RUN npm run build

# Stage 2: Nginx serve static files
FROM nginx:alpine

# 删除默认配置
RUN rm /etc/nginx/conf.d/default.conf

# 复制构建产物
COPY --from=builder /app/frontend/client/dist /usr/share/nginx/html

# Nginx 配置由 docker-compose 挂载
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
