{
  "name": "personal-homepage-monorepo",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:collab\"",
    "dev:server": "ts-node-dev --respawn --transpile-only src/main.ts",
    "dev:client": "npm --workspace client run dev",
    "dev:collab": "node collab-server.mjs",
    "build": "npm --workspace client run build && npm run build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && npm --workspace client run typecheck"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "http-proxy-middleware": "^3.0.3",
    "lib0": "^0.2.117",
    "react-quill": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.20.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
